SERVERS_DIR=/etc/nagstamon/servers
HOST_SERVERS_DIR=~/.nagstamon/servers
PROXY_ADDR=http://proxy.example:3128
VPN_IFACE=
VPN_ADDR=
REFRESH_INTERVAL=30
HTTP_TIMEOUT_SECONDS=5
HTTP_MAX_WORKERS=30
DEDUP_ENABLED=true
DEDUP_WINDOW_MINUTES=30
DEDUP_LEDGER_PATH=data/dispatch-ledger.json
FILTER_WINDOW_START=13:30
FILTER_WINDOW_END=18:00
FILTER_TIMEZONE=America/Sao_Paulo
FILTER_HOLD_FAST_SECONDS=180
FILTER_HOLD_CRITICAL_SECONDS=180
FILTER_HOLD_WARNING_SECONDS=600
FILTER_DURATION_MAX_SECONDS=86400
SOUND_ENABLED=true
GCHAT_WEBHOOK_URL=

LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_FILE=
