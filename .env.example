# Runtime / Infra
SERVERS_DIR=/etc/nagstamon/servers
HOST_SERVERS_DIR=~/.nagstamon/servers
PROXY_ADDR=http://proxy.example:3128
VPN_IFACE=
VPN_ADDR=
REFRESH_INTERVAL_SECONDS=30
HTTP_TIMEOUT_SECONDS=5
HTTP_MAX_WORKERS=30

# Google Chat / Notificacoes
GCHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/SUBSTITUA_SPACE/messages?key=SUBSTITUA_KEY&token=SUBSTITUA_TOKEN
SOUND_ENABLED=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_FILE=
LOG_DIR=logs

# Deduplicacao
DEDUP_ENABLED=true
DEDUP_WINDOW_MINUTES=30
DEDUP_LEDGER_PATH=data/dispatch-ledger.json

# Janela Comercial Compartilhada (WINDOW_*)
# Turnos: Manhã (08:30 às 13:30) / Tarde (13:30 às 18:00)
# WINDOW_ALLOW_PAST_ACTIVE_ALERTS: se true, emite alertas ativos iniciados na madrugada/antes do boot (default true se WINDOW_START < 12:00)
WINDOW_ENABLED=true
WINDOW_DAYS=mon,tue,wed,thu,fri
WINDOW_START=08:30
WINDOW_END=13:30
WINDOW_TIMEZONE=America/Sao_Paulo
WINDOW_ALLOW_PAST_ACTIVE_ALERTS=true

# Hold-down de Persistencia (Exclusivo Nagstamon)
FILTER_HOLD_FAST_SECONDS=600
FILTER_HOLD_CRITICAL_SECONDS=900
FILTER_HOLD_WARNING_SECONDS=1200
FILTER_DURATION_MAX_SECONDS=86400
